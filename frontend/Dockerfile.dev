FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY angular.json tsconfig.json tsconfig.app.json ./
COPY src ./src

EXPOSE 4200

# --poll : indispensable sous Docker Desktop (Windows/Mac) pour détecter les changements de fichiers
CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--port", "4200", "--poll", "2000"]
