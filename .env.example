DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=portail_medecin

# Local uniquement (docker-compose.override.yml). Ignoré sur Dokploy.
HTTP_PORT=80
NODE_ENV=production

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
BETTER_AUTH_SECRET=replace-with-a-long-random-better-auth-secret

FRONTEND_ORIGIN=http://localhost

# true = à chaque démarrage du backend : db push + reset BDD + seed démo (+ purge uploads).
# Dokploy démo/staging : laisser true. Vraie prod avec données réelles : false.
RESET_DB_ON_SEED=true

# Démo : true pour autoriser POST /api/auth/register.
# Prod : laisser false (inscription publique fermée).
ALLOW_PUBLIC_REGISTER=false
