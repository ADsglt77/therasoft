DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=portail_medecin

HTTP_PORT=80
NODE_ENV=production

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

FRONTEND_ORIGIN=http://localhost

# Démo : reset complet de la base à chaque démarrage + données de test.
# Prod : mettre false pour un seed idempotent (aucune perte de données).
RESET_DB_ON_SEED=true

# Démo : true pour autoriser POST /api/auth/register.
# Prod : laisser false (inscription publique fermée).
ALLOW_PUBLIC_REGISTER=false
