# ===========================================
# Déploiement VPS : mettre FRONTEND_ORIGIN=http://IP_DU_VPS (ou ton domaine)
# et NODE_ENV=production. Voir DEPLOY.md pour la procédure complète.
# ===========================================

# Database
DB_USER=USER
DB_PASSWORD=PASS
DB_NAME=NAME
# Pour lancer SANS Docker : utilisez localhost au lieu de db
DATABASE_URL=postgresql://USER:PASS@localhost:5432/NAME?schema=public

# Ports
FRONTEND_PORT=4200
BACKEND_PORT=3000
DB_PORT=5432

# API
API_BASE_URL=http://localhost:3000

# Environment (development | production)
NODE_ENV=development

# JWT (en production : générer des secrets longs et aléatoires)
JWT_ACCESS_SECRET=123
JWT_REFRESH_SECRET=1234
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Frontend (CORS + cookies). En VPS : http://IP_DU_VPS ou https://ton-domaine.com
FRONTEND_ORIGIN=http://localhost:4200
