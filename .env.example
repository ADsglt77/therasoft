# ─────────────────────────────────────────────────────────────
# Fichier .env UNIQUE (centralisé à la racine). Copier en `.env`.
#  • docker-compose.yml l'utilise pour l'interpolation ${...}
#  • le backend en dev natif le charge via `npm run dev` (--env-file=../.env)
# En prod (Dokploy), définir ces variables dans le panneau, avec les valeurs publiques.
# ─────────────────────────────────────────────────────────────

# Base PostgreSQL (compose). DATABASE_URL doit utiliser les mêmes identifiants.
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=portail_medecin

# Connexion du backend en dev natif (base publiée sur 127.0.0.1:5432 par Docker).
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/portail_medecin?schema=public

PORT=3000
# development en local · production en prod (Dokploy)
NODE_ENV=development

# Secret Better Auth — au moins 32 caractères aléatoires.
AUTH_SECRET=replace-with-a-long-random-secret-min-32-chars

# URL du front : http://localhost:4200 en dev natif · domaine public en prod.
FRONTEND_ORIGIN=http://localhost:4200
APP_URL=http://localhost:4200

# SMTP (vérification d'email) — vide = lien seulement loggé (docker compose logs backend).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TsXcare <no-reply@tsxcare.local>
