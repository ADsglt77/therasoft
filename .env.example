DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=portail_medecin

# Local uniquement (docker-compose.override.yml). Ignoré sur Dokploy.
HTTP_PORT=80
NODE_ENV=production

# Secret Better Auth (signature des sessions) — ≥ 32 caractères aléatoires.
AUTH_SECRET=replace-with-a-long-random-secret-min-32-chars

FRONTEND_ORIGIN=http://localhost
APP_URL=http://localhost

# SMTP optionnel. Sans SMTP_HOST, les emails de vérification ne peuvent pas être envoyés.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TsXcare <no-reply@tsxcare.local>

# true = reset explicite de la BDD + seed démo (+ purge uploads) au démarrage.
# Valeur sûre par défaut : false. N'activer true que sur une démo jetable.
RESET_DB_ON_SEED=false

# À activer une seule fois pour une base historique vérifiée, créée avant les migrations Prisma.
BASELINE_EXISTING_DB=false
