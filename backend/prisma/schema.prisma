generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
// - Role: MEDECIN (personnel médical, dashboard), PATIENT (portail patient)
// - Sexe: optionnel mais propre
// - ModaliteType: type d'examen / machine (Vacation et Rdv)
enum Role {
  MEDECIN
  PATIENT
}

enum Sexe {
  M
  F
  X
  UNKNOWN
}

enum ModaliteType {
  XRAY
  CT
  MRI
  US
  MAMMO
  PET
  OTHER
}

model Medecin {
  id         Int     @id @default(autoincrement())
  nom        String
  prenom     String

  isActive       Boolean   @default(true) @map("is_active")

  userId         String    @unique @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vacations  Vacation[]
  auditLogs  AuditLog[]
  patients   Patient[] @relation("PatientMedecin")
  rdvs       Rdv[]

  @@map("medecin")
}

model Vacation {
  id Int @id @default(autoincrement())

  date    DateTime @db.Date
  horaire DateTime @db.Time(0)

  modalite ModaliteType

  siteId Int  @map("id_site")
  site   Site @relation(fields: [siteId], references: [id])

  medecinId Int     @map("id_medecin")
  medecin   Medecin @relation(fields: [medecinId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rdvLinks RdvVacation[]

  @@index([medecinId])
  @@index([date])
  @@index([medecinId, date])
  @@index([medecinId, siteId, modalite, date])
  @@index([siteId])
  @@map("vacation")
}

// Site = établissement (hôpital / clinique) dans une ville.
// Métadonnées affichées dans l'onglet Site : localisation, horaires, liens.
model Site {
  id    Int    @id @default(autoincrement())
  nom   String
  ville String

  adresse   String?
  latitude  Float?
  longitude Float?

  websiteUrl String? @map("website_url")
  /// Horaires d'ouverture : tableau JSON [{ day: 1-7 (lun→dim), open: "HH:mm", close: "HH:mm" }]
  openingHours Json? @map("opening_hours")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vacations Vacation[]
  rdvs      Rdv[]

  @@unique([nom, ville])
  @@map("site")
}

model Patient {
  id            Int       @id @default(autoincrement())
  nom           String
  prenom        String
  dateNaissance DateTime? @map("date_naissance") @db.Date
  sexe          Sexe?     @default(UNKNOWN)

  // Adresse postale vérifiée (API Adresse gouv.fr) + coordonnées GPS, pour le tri par distance.
  adresse   String?
  latitude  Float?
  longitude Float?

  userId    String?  @unique @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  medecinId Int?     @map("id_medecin")
  medecin   Medecin? @relation("PatientMedecin", fields: [medecinId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rdvs     Rdv[]

  @@index([nom, prenom])
  @@index([dateNaissance])
  @@index([medecinId])
  @@map("patient")
}

model Rdv {
  id Int @id @default(autoincrement())

  date       DateTime @db.Date
  heureDebut DateTime @map("heure_debut") @db.Time(0)
  heureFin   DateTime @map("heure_fin") @db.Time(0)

  modalite ModaliteType
  motif    String?

  patientId Int     @map("id_patient")
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Réservation patient : médecin + site choisis (null pour les RDV seedés liés via vacation).
  medecinId Int?     @map("id_medecin")
  medecin   Medecin? @relation(fields: [medecinId], references: [id], onDelete: SetNull)

  siteId Int?  @map("id_site")
  site   Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vacationLinks RdvVacation[]
  dossier       Dossier?

  @@index([patientId])
  @@index([date])
  @@index([patientId, date])
  @@index([medecinId])
  @@index([medecinId, date])
  @@index([siteId, date])
  @@map("rdv")
}

// Liaison RDV ↔ Vacation : le RDV n'est visible/planifiable que si la vacation
// expose la même modalité (machine / type d'examen) ce jour-là.
model RdvVacation {
  id Int @id @default(autoincrement())

  rdvId Int @map("id_rdv")
  rdv   Rdv @relation(fields: [rdvId], references: [id], onDelete: Cascade)

  vacationId Int      @map("id_vacation")
  vacation   Vacation @relation(fields: [vacationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([rdvId, vacationId])
  @@index([rdvId])
  @@index([vacationId])
  @@map("rdv_vacation")
}

// Un dossier par RDV (patient dérivé via rdv.patient)
model Dossier {
  id Int @id @default(autoincrement())

  rdvId Int @unique @map("id_rdv")
  rdv   Rdv @relation(fields: [rdvId], references: [id], onDelete: Cascade)

  observations String?

  /// Date à laquelle observations + au moins un fichier sont renseignés (prêt opération)
  operationReadyAt DateTime? @map("operation_ready_at")

  /// Marqué manuellement « vérifié / complet » par le médecin (badge « Vérif »)
  verified Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  files DossierFile[]

  @@map("dossier")
}

model DossierFile {
  id Int @id @default(autoincrement())

  dossierId Int     @map("id_dossier")
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  originalName String @map("original_name")
  storedName   String @map("stored_name")
  mimeType     String @map("mime_type")
  size         Int

  createdAt DateTime @default(now()) @map("created_at")

  @@index([dossierId])
  @@unique([storedName])
  @@map("dossier_file")
}

model AuditLog {
  id Int @id @default(autoincrement())

  medecinId Int?    @map("id_medecin")
  medecin   Medecin? @relation(fields: [medecinId], references: [id], onDelete: SetNull)

  action     String
  resource   String
  resourceId String? @map("resource_id")
  ip         String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([medecinId])
  @@index([createdAt])
  @@index([resource, resourceId])
  @@map("audit_log")
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @map("email_verified")
  image         String?
  createdAt     DateTime  @map("created_at")
  updatedAt     DateTime  @map("updated_at")
  
  role          Role      @default(PATIENT)
  
  sessions      Session[]
  accounts      Account[]
  
  medecin       Medecin?
  patient       Patient?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @map("created_at")
  updatedAt             DateTime  @map("updated_at")

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// Durée (en minutes) d'un rendez-vous selon la modalité — éditable en base.
model ModaliteConfig {
  id           Int          @id @default(autoincrement())
  modalite     ModaliteType @unique
  dureeMinutes Int          @map("duree_minutes")

  @@map("modalite_config")
}
